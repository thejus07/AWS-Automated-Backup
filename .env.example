# ==============================================================================
# AWS Automated Backup & Recovery System - Environment Configuration Template
# Copy this file to '.env' and update the values to match your environment.
# Note: On EC2 instances using IAM Roles, leave AWS credentials blank.
# ==============================================================================

# AWS General Configuration
AWS_REGION=us-east-1

# Amazon S3 Backup Target Configuration
S3_BUCKET_NAME=your-backup-bucket-name-here
S3_BACKUP_PREFIX=backups

# Backup Source & Format
# Path to directory on EC2/Linux instance to backup
BACKUP_SOURCE_DIR=/var/data
# Archive compression format: 'tar.gz' or 'zip'
BACKUP_FORMAT=tar.gz

# Restore Configuration
# Default target directory for restoring archives
RESTORE_DIR=/var/data_restored

# AWS CloudWatch Monitoring & Metrics
ENABLE_CLOUDWATCH_METRICS=true
ENABLE_CLOUDWATCH_LOGS=true
CLOUDWATCH_NAMESPACE=AWSBackupRecovery/EC2
CLOUDWATCH_LOG_GROUP=/aws/ec2/backup-recovery

# Amazon SNS Alerts (Optional: if notifying directly from script in addition to CloudWatch Alarms)
SNS_TOPIC_ARN=

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/backup.log
